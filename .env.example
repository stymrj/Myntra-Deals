# Myntra Deals bot — copy to .env and fill in your own values. Never commit .env.
# Copy to .env for local runs: node bot/run.js --dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum discount to alert on (per-group overrides live in bot/config.json)
MIN_DISCOUNT=60
MAX_WORKERS=3
PAGES=1
# Optional
# THRESHOLDS=men=55,beauty=50
# GROUPS=men,women,footwear
# DIGEST_HOUR_IST=9
# MAX_ALERTS=40
