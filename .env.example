# Myntra Deals bot — copy to .env and fill in your own values. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum discount to alert on (per-group overrides live in bot/config.json)
MIN_DISCOUNT=60
MAX_WORKERS=3
PAGES=1
# Optional pincode used by the listing-page fallback (leave blank to skip it)
MYNTRA_PINCODE=
